#!/bin/sh
# The universal panel owns one Quickshell instance. Specialized pickers keep Rofi.
set -eu

ARGVUS_SYSTEM_CONFIG=${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}
launcher_tr() {
  argvus i18n get launcher "$1"
}

if [ "$#" -gt 0 ]; then
  case "$1" in
    --help|-h)
      launcher_tr universal.cli_help
      exit 0
      ;;
    --config)
      launcher_tr universal.rasi_unsupported >&2
      exit 2
      ;;
    *)
      launcher_tr universal.argument_unsupported >&2
      exit 2
      ;;
  esac
fi

PANEL="$ARGVUS_SYSTEM_CONFIG/launcher/quickshell"
if qs -p "$PANEL" ipc call launcher toggle >/dev/null 2>&1; then
  exit 0
fi
exec qs -n -d -p "$PANEL"
