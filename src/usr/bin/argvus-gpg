#!/usr/bin/env sh
# GPG key manager: list keys, generate a key with an encryption subkey, export
# and import public keys. gpg-agent always uses pinentry-gtk, which ARGVUS
# writes into gpg-agent.conf when a key is generated.
#
# Passphrases never reach this script or any process argument. gpg asks the
# pinentry itself, so the secret is typed only into the pinentry window. The
# one exception is --no-passphrase, which passes an empty passphrase: it is
# not a secret, and it is refused without --yes.
#
# Private keys are never exported. Import refuses any file that carries
# secret key packets.
#
# Usage:
#   argvus gpg                                        show this help
#   argvus gpg list                                   print keys as TSV
#   argvus gpg generate UID [--algo rsa|dsa] [--bits 1024|2048|3072|4096]
#                           [--expire 0|2y|YYYY-MM-DD|...]
#                           [--passphrase-stdin | --no-passphrase --yes]
#                           with --passphrase-stdin, the passphrase is the first
#                           line of stdin; without it, the pinentry asks
#   argvus gpg export-public ID FILE [--force]        write the public key
#   argvus gpg import FILE                            import public keys
#   argvus gpg status                                 show the pinentry in use

set -eu

ARGVUS_SYSTEM_CONFIG=${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}
ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-$ARGVUS_SYSTEM_CONFIG/session/sh/bootstrap.sh}"

if [ -r "$ARGVUS_BOOTSTRAP" ]; then
  # shellcheck disable=SC1090,SC1091
  . "$ARGVUS_BOOTSTRAP"
else
  if [ -r "$ARGVUS_SYSTEM_CONFIG/lib/i18n.sh" ]; then
    # shellcheck disable=SC1090,SC1091
    . "$ARGVUS_SYSTEM_CONFIG/lib/i18n.sh"
  fi
fi

GNUPG_HOME="${GNUPGHOME:-$HOME/.gnupg}"
AGENT_CONF="$GNUPG_HOME/gpg-agent.conf"

# Lines between these markers belong to ARGVUS. Everything else in
# gpg-agent.conf is the user's and is kept as it is.
MARK_BEGIN='# BEGIN argvus-managed pinentry'
MARK_END='# END argvus-managed pinentry'

# The one pinentry ARGVUS uses. It is not a user choice, so the Control Center
# does not offer one.
PINENTRY_BIN=pinentry-gtk

# A temporary file that must not outlive the script, if a step fails midway.
tmp_file=''
trap 'if [ -n "$tmp_file" ]; then rm -f "$tmp_file"; fi' EXIT

# Set by generate; read by gpg_secret_op. secret_passphrase is only filled when
# --passphrase-stdin is given, and it never appears in an argument list.
no_passphrase=0
passphrase_stdin=0
secret_passphrase=''

# Shows an error for a shortcut run, where stderr is not visible, then stops.
report_error() {
  message=$1
  printf 'argvus-gpg: %s\n' "$message" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a argvus-gpg "$message" || true
  fi
  exit 1
}

usage() {
  argvus_tr launcher error.gpg_usage >&2
  exit 1
}

require_gpg() {
  command -v gpg >/dev/null 2>&1 || report_error "$(argvus_tr launcher error.gpg_missing)"
}

# A user ID is free text, so only the length and control characters are
# checked. A leading dash would read as an option to gpg.
valid_uid() {
  case "$1" in
    ''|-*) return 1 ;;
  esac
  [ "${#1}" -le 200 ] || return 1
  ! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'
}

# A key id, fingerprint or mail address, with no characters that could be read
# as a path or an option.
valid_id() {
  case "$1" in
    ''|-*|*[!A-Za-z0-9@._+-]*) return 1 ;;
    *) return 0 ;;
  esac
}

valid_algo() {
  case "$1" in
    rsa|dsa) return 0 ;;
    *) return 1 ;;
  esac
}

# DSA keys are limited to 3072 bits by gpg, so 4096 is refused here with a clear
# message instead of a generic gpg failure. The first field is the algorithm.
valid_key_bits() {
  case "$1:$2" in
    rsa:1024|rsa:2048|rsa:3072|rsa:4096) return 0 ;;
    dsa:1024|dsa:2048|dsa:3072) return 0 ;;
    *) return 1 ;;
  esac
}

# 0 for no expiry, a number followed by d, w, m or y, or an ISO date. The
# Control Center converts the user's date format to ISO before calling this.
valid_expire() {
  printf '%s' "$1" | grep -Eq '^(0|[0-9]+[dwmy]|[0-9]{4}-[0-9]{2}-[0-9]{2})$'
}

# Runs a gpg step that uses the secret key. With --no-passphrase the empty
# passphrase is passed in loopback mode, so the pinentry is not asked. With
# --passphrase-stdin the passphrase is written to gpg's file descriptor 0 from a
# pipe, so it is never an argument, and each step gets its own copy.
gpg_secret_op() {
  if [ "$no_passphrase" -eq 1 ]; then
    gpg --batch --pinentry-mode loopback --passphrase '' "$@"
  elif [ "$passphrase_stdin" -eq 1 ]; then
    printf '%s\n' "$secret_passphrase" | gpg --batch --pinentry-mode loopback --passphrase-fd 0 "$@"
  else
    gpg "$@"
  fi
}

# Prints "fingerprint<TAB>keyid<TAB>type<TAB>expires<TAB>secret<TAB>validity<TAB>uid"
# for each primary key. The secret flag is yes when the fingerprint also
# appears in the secret key listing. Expiry is a date, or "never".
list_keys() {
  require_gpg
  secret_fps=$(gpg --batch --with-colons --fixed-list-mode --list-secret-keys 2>/dev/null \
    | awk -F: '$1 == "fpr" { print $10 }')
  gpg --batch --with-colons --fixed-list-mode --list-keys 2>/dev/null \
    | SECRET_FPS="$secret_fps" awk -F: '
      function algo_name(id) {
        if (id == 1) return "rsa"
        if (id == 16) return "elgamal"
        if (id == 17) return "dsa"
        if (id == 18) return "ecc"
        if (id == 19) return "ecdsa"
        if (id == 22) return "ed25519"
        return "other"
      }
      function flush() {
        if (fp == "") return
        secret = index("\n" ENVIRON["SECRET_FPS"] "\n", "\n" fp "\n") ? "yes" : "no"
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", fp, keyid, type, expires, secret, validity, uid
        fp = ""
      }
      $1 == "pub" {
        flush()
        keyid = $5
        type = algo_name($4)
        validity = $2
        expires = "never"
        if ($7 ~ /^[0-9]+$/) {
          cmd = "date -u -d @" $7 " +%Y-%m-%d"
          cmd | getline expires
          close(cmd)
        }
        fp = ""
        uid = ""
        in_primary = 1
        next
      }
      $1 == "sub" { in_primary = 0; next }
      $1 == "fpr" { if (in_primary && fp == "") fp = $10; next }
      $1 == "uid" {
        if (uid == "") {
          uid = $10
          gsub(/\\x3a/, ":", uid)
          gsub(/\t/, " ", uid)
        }
        next
      }
      END { flush() }
    '
}

generate_key() {
  uid=''
  algo=rsa
  bits=''
  expire=2y
  confirmed=0
  no_passphrase=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --algo)
        [ "$#" -ge 2 ] || usage
        algo=$2
        shift 2
        ;;
      --bits)
        [ "$#" -ge 2 ] || usage
        bits=$2
        shift 2
        ;;
      --expire)
        [ "$#" -ge 2 ] || usage
        expire=$2
        shift 2
        ;;
      --no-passphrase)
        no_passphrase=1
        shift
        ;;
      --passphrase-stdin)
        passphrase_stdin=1
        shift
        ;;
      --yes)
        confirmed=1
        shift
        ;;
      -*)
        usage
        ;;
      *)
        [ -z "$uid" ] || usage
        uid=$1
        shift
        ;;
    esac
  done
  [ -n "$uid" ] || usage
  # The two ways to protect a key cannot be combined.
  if [ "$no_passphrase" -eq 1 ] && [ "$passphrase_stdin" -eq 1 ]; then
    usage
  fi
  valid_uid "$uid" || report_error "$(argvus_tr launcher error.gpg_invalid_uid)"
  valid_algo "$algo" || report_error "$(argvus_tr launcher error.gpg_bad_algo algo="$algo")"
  # Without --bits, RSA gets 4096 and DSA gets 2048, the sizes gpg recommends.
  if [ -z "$bits" ]; then
    case "$algo" in
      rsa) bits=4096 ;;
      dsa) bits=2048 ;;
    esac
  fi
  valid_key_bits "$algo" "$bits" || report_error "$(argvus_tr launcher error.gpg_bad_bits algo="$algo" bits="$bits")"
  valid_expire "$expire" || report_error "$(argvus_tr launcher error.gpg_bad_expire expire="$expire")"
  if [ "$no_passphrase" -eq 1 ] && [ "$confirmed" -ne 1 ]; then
    report_error "$(argvus_tr launcher error.gpg_confirm_no_passphrase)"
  fi
  require_gpg
  if [ "$passphrase_stdin" -eq 1 ]; then
    # The first line of stdin is the passphrase. A missing line or an empty one
    # is refused, because it would make an unprotected key by accident.
    IFS= read -r secret_passphrase || secret_passphrase=''
    [ -n "$secret_passphrase" ] || report_error "$(argvus_tr launcher error.gpg_passphrase_empty)"
  fi
  ensure_pinentry

  # The status line names the new fingerprint, which avoids searching by user
  # ID when several keys share one.
  status_out=$(gpg_secret_op --status-fd 1 --quick-gen-key "$uid" "$algo$bits" default "$expire") \
    || report_error "$(argvus_tr launcher error.gpg_generate_failed)"
  fp=$(printf '%s\n' "$status_out" | awk '$2 == "KEY_CREATED" { print $4; exit }')
  [ -n "$fp" ] || report_error "$(argvus_tr launcher error.gpg_generate_failed)"

  # A primary key with certify and sign usage cannot encrypt, so an encryption
  # subkey is added for file encryption and pass. DSA keys pair with an
  # ElGamal encryption subkey of the same size, as the DSA standard requires.
  case "$algo" in
    rsa) subkey_algo="rsa$bits" ;;
    dsa) subkey_algo="elg$bits" ;;
  esac
  gpg_secret_op --quick-add-key "$fp" "$subkey_algo" encr "$expire" >/dev/null \
    || report_error "$(argvus_tr launcher error.gpg_subkey_failed fingerprint="$fp")"
  argvus_tr launcher message.gpg_generated fingerprint="$fp"
}

# Makes gpg-agent use PINENTRY_BIN. The line lives in the ARGVUS block of
# gpg-agent.conf; the user's own lines are kept. A pinentry-program line the
# user wrote outside that block is refused, because two values for the same
# option would conflict. gpg-agent is restarted only when the block changes.
ensure_pinentry() {
  program=$(command -v "$PINENTRY_BIN" 2>/dev/null) \
    || report_error "$(argvus_tr launcher error.gpg_pinentry_missing bin="$PINENTRY_BIN")"

  if [ -f "$AGENT_CONF" ]; then
    user_line=$(awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
      $0 == b { skip = 1; next }
      $0 == e { skip = 0; next }
      !skip && /^[[:space:]]*pinentry-program[[:space:]]/ { print; exit }
    ' "$AGENT_CONF")
    [ -z "$user_line" ] || report_error "$(argvus_tr launcher error.gpg_pinentry_conflict)"
    current=$(awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
      $0 == b { skip = 1; next }
      $0 == e { skip = 0; next }
      skip && /^pinentry-program[[:space:]]/ { print $2; exit }
    ' "$AGENT_CONF")
    # The block already names this program, so the file and agent stay as they are.
    if [ "$current" = "$program" ]; then
      return 0
    fi
  fi

  if [ ! -d "$GNUPG_HOME" ]; then
    mkdir -p "$GNUPG_HOME"
    chmod 700 "$GNUPG_HOME"
  fi
  umask 077
  tmp_file=$(mktemp "$GNUPG_HOME/.gpg-agent.conf.XXXXXX")
  {
    if [ -f "$AGENT_CONF" ]; then
      awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        !skip { print }
      ' "$AGENT_CONF"
    fi
    printf '%s\npinentry-program %s\n%s\n' "$MARK_BEGIN" "$program" "$MARK_END"
  } >"$tmp_file"
  if [ -f "$AGENT_CONF" ]; then
    cp -p "$AGENT_CONF" "$AGENT_CONF.bak"
  fi
  mv -f "$tmp_file" "$AGENT_CONF"
  tmp_file=''
  # gpg-agent reads its configuration once, so it restarts and starts with
  # the new pinentry. Without an agent running, nothing needs stopping.
  if command -v gpgconf >/dev/null 2>&1; then
    gpgconf --kill gpg-agent >/dev/null 2>&1 || true
  fi
}

export_public() {
  [ "$#" -ge 2 ] || usage
  id=$1
  file=$2
  shift 2
  force=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      *) usage ;;
    esac
    shift
  done
  valid_id "$id" || report_error "$(argvus_tr launcher error.gpg_invalid_id id="$id")"
  require_gpg
  if [ "$file" = - ]; then
    # Standard output, so the Control Center can copy the key without a file.
    public_key=$(gpg --batch --armor --export "$id" 2>/dev/null) || public_key=''
    [ -n "$public_key" ] || report_error "$(argvus_tr launcher error.gpg_no_key id="$id")"
    printf '%s\n' "$public_key"
    exit 0
  fi
  case "$file" in
    /*) ;;
    *) file="$PWD/$file" ;;
  esac
  dir=$(dirname "$file")
  [ -d "$dir" ] || report_error "$(argvus_tr launcher error.gpg_no_dir file="$file")"
  if [ -e "$file" ] && [ "$force" -ne 1 ]; then
    report_error "$(argvus_tr launcher error.gpg_file_exists file="$file")"
  fi
  require_gpg

  # The export goes to a private temporary file in the same directory, and it
  # is renamed into place only when it holds a key.
  umask 077
  tmp_file=$(mktemp "$dir/.argvus-gpg-export.XXXXXX") \
    || report_error "$(argvus_tr launcher error.gpg_export_failed file="$file")"
  gpg --batch --armor --export "$id" >"$tmp_file" 2>/dev/null \
    || report_error "$(argvus_tr launcher error.gpg_export_failed file="$file")"
  [ -s "$tmp_file" ] || report_error "$(argvus_tr launcher error.gpg_no_key id="$id")"
  mv -f "$tmp_file" "$file"
  tmp_file=''
  argvus_tr launcher message.gpg_exported file="$file"
}

import_key() {
  [ "$#" -eq 1 ] || usage
  file=$1
  [ -f "$file" ] && [ -r "$file" ] || report_error "$(argvus_tr launcher error.gpg_not_readable file="$file")"
  require_gpg
  case "$file" in
    /*) ;;
    *) file="$PWD/$file" ;;
  esac
  # --list-packets reads both ASCII-armored and binary files, so a private key
  # is caught in either form.
  if gpg --batch --list-packets "$file" 2>/dev/null | grep -Eq ':secret (sub )?key packet:'; then
    report_error "$(argvus_tr launcher error.gpg_private_refused file="$file")"
  fi
  gpg --batch --import "$file" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_import_failed file="$file")"
  argvus_tr launcher message.gpg_imported file="$file"
}

# Version of the command set this script implements. The Control Center refuses
# to show GPG actions when the installed value is lower than the one it needs,
# so raise it whenever a subcommand or an option is added or changed.
GPG_API=2

# Prints the state as TSV: the API version, gnupg, then pinentry with its path
# and whether it is written by ARGVUS or by the user.
status_pinentry() {
  printf 'api\t%s\n' "$GPG_API"
  if command -v gpg >/dev/null 2>&1; then
    printf 'gnupg\tyes\n'
  else
    printf 'gnupg\tno\n'
  fi
  if [ ! -f "$AGENT_CONF" ]; then
    printf 'pinentry\tnone\tdefault\n'
    return 0
  fi
  managed=$(awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    skip && /^pinentry-program[[:space:]]/ { print $2; exit }
  ' "$AGENT_CONF")
  user=$(awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip && /^[[:space:]]*pinentry-program[[:space:]]/ { print $2; exit }
  ' "$AGENT_CONF")
  if [ -n "$managed" ]; then
    printf 'pinentry\t%s\targvus\n' "$managed"
  elif [ -n "$user" ]; then
    printf 'pinentry\t%s\tuser\n' "$user"
  else
    printf 'pinentry\tnone\tdefault\n'
  fi
}

# A full fingerprint: 40 upper-case hex digits. Secret-key commands take only
# this form, so a short key id can never select a different key.
valid_fingerprint() {
  printf '%s' "$1" | grep -Eq '^[0-9A-F]{40}$'
}

# An absolute path for a file the user named relative to the working directory.
absolute_path() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$PWD" "$1" ;;
  esac
}

# Destructive and publishing commands run only with --yes, which the Control
# Center passes after its own confirmation.
require_yes() {
  [ "$1" -eq 1 ] || report_error "$(argvus_tr launcher error.gpg_confirm_action)"
}

# Prints the subkey fingerprints of a key, one per line.
subkey_fingerprints() {
  gpg --batch --with-colons --fixed-list-mode --list-keys "$1" 2>/dev/null | awk -F: '
    $1 == "pub" { in_sub = 0 }
    $1 == "sub" { in_sub = 1; next }
    $1 == "fpr" && in_sub { print $10; in_sub = 0 }
  '
}

# Writes an armored file atomically: a private temporary file in the target
# directory, renamed into place only when it holds data. Used for exports.
write_export() {
  file=$1
  shift
  dir=$(dirname "$file")
  [ -d "$dir" ] || report_error "$(argvus_tr launcher error.gpg_no_dir file="$file")"
  if [ -e "$file" ] && [ "$force" -ne 1 ]; then
    report_error "$(argvus_tr launcher error.gpg_file_exists file="$file")"
  fi
  umask 077
  tmp_file=$(mktemp "$dir/.argvus-gpg-export.XXXXXX") \
    || report_error "$(argvus_tr launcher error.gpg_export_failed file="$file")"
  "$@" >"$tmp_file" 2>/dev/null \
    || report_error "$(argvus_tr launcher error.gpg_export_failed file="$file")"
  [ -s "$tmp_file" ] || report_error "$(argvus_tr launcher error.gpg_no_secret_key fingerprint="$fingerprint")"
  mv -f "$tmp_file" "$file"
  tmp_file=''
}

# Imports a file that holds a private key. The key stays protected by its
# passphrase; gpg asks for it when the key is used.
import_private() {
  [ "$#" -eq 1 ] || usage
  file=$1
  [ -f "$file" ] && [ -r "$file" ] || report_error "$(argvus_tr launcher error.gpg_not_readable file="$file")"
  require_gpg
  file=$(absolute_path "$file")
  gpg --batch --list-packets "$file" 2>/dev/null | grep -Eq ':secret (sub )?key packet:' \
    || report_error "$(argvus_tr launcher error.gpg_not_private file="$file")"
  gpg --no-tty --batch --import "$file" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_import_failed file="$file")"
  argvus_tr launcher message.gpg_private_imported file="$file"
}

# Exports the private key of one fingerprint, armored, with mode 600. Gpg keeps
# the key's own passphrase protection, so no passphrase is asked here.
export_private() {
  [ "$#" -ge 2 ] || usage
  fingerprint=$1
  file=$2
  shift 2
  force=0
  confirmed=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --yes) confirmed=1 ;;
      *) usage ;;
    esac
    shift
  done
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  require_yes "$confirmed"
  require_gpg
  file=$(absolute_path "$file")
  write_export "$file" gpg --no-tty --batch --armor --export-secret-keys "$fingerprint"
  argvus_tr launcher message.gpg_private_exported file="$file"
}

# Deletes a key by its full fingerprint. A key with a secret part is removed
# together with it.
delete_key() {
  [ "$#" -ge 1 ] || usage
  fingerprint=$1
  shift
  confirmed=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) confirmed=1 ;;
      *) usage ;;
    esac
    shift
  done
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  require_yes "$confirmed"
  require_gpg
  if gpg --batch --list-secret-keys "$fingerprint" >/dev/null 2>&1; then
    gpg --no-tty --batch --yes --delete-secret-and-public-key "$fingerprint" >/dev/null 2>&1 \
      || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  else
    gpg --no-tty --batch --yes --delete-keys "$fingerprint" >/dev/null 2>&1 \
      || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  fi
  argvus_tr launcher message.gpg_deleted fingerprint="$fingerprint"
}

# Changes the expiry of the primary key and of each subkey: `0` or a date form
# accepted by generate. gpg sets the primary key from one call, and a subkey
# only when its fingerprint is named, so each subkey gets its own call.
edit_expire() {
  [ "$#" -eq 2 ] || usage
  fingerprint=$1
  expire=$2
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  valid_expire "$expire" || report_error "$(argvus_tr launcher error.gpg_bad_expire expire="$expire")"
  require_gpg
  gpg_secret_op --no-tty --batch --yes --quick-set-expire "$fingerprint" "$expire" >/dev/null \
    || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  for subkey in $(subkey_fingerprints "$fingerprint"); do
    gpg_secret_op --no-tty --batch --yes --quick-set-expire "$fingerprint" "$expire" "$subkey" >/dev/null \
      || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  done
  argvus_tr launcher message.gpg_expire_set fingerprint="$fingerprint"
}

# Changes the passphrase of a key. gpg asks the old and the new one through the
# pinentry window, so neither ever reaches this script.
edit_passwd() {
  [ "$#" -eq 1 ] || usage
  fingerprint=$1
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  require_gpg
  ensure_pinentry
  gpg --no-tty --change-passphrase "$fingerprint" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  argvus_tr launcher message.gpg_passphrase_changed fingerprint="$fingerprint"
}

# Certifies a key with another key of this keyring that has a secret part, so
# the key becomes trusted through that signer.
edit_sign() {
  [ "$#" -ge 2 ] || usage
  fingerprint=$1
  signer=$2
  shift 2
  confirmed=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) confirmed=1 ;;
      *) usage ;;
    esac
    shift
  done
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  valid_fingerprint "$signer" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$signer")"
  require_yes "$confirmed"
  require_gpg
  gpg --batch --list-secret-keys "$signer" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_signer_not_secret fingerprint="$signer")"
  ensure_pinentry
  gpg_secret_op --no-tty --batch --yes --local-user "$signer" --quick-sign-key "$fingerprint" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  argvus_tr launcher message.gpg_signed fingerprint="$fingerprint"
}

# Revokes a key with a reason. gpg runs its own revocation dialog through
# --command-fd, so the answers come from this script and not from a terminal.
# --no-tty stops gpg from opening /dev/tty, which does not exist here.
edit_revoke() {
  [ "$#" -ge 2 ] || usage
  fingerprint=$1
  shift
  reason=''
  confirmed=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --reason)
        [ "$#" -ge 2 ] || usage
        reason=$2
        shift 2
        continue
        ;;
      --yes) confirmed=1 ;;
      *) usage ;;
    esac
    shift
  done
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  case "$reason" in
    none) code=0 ;;
    compromised) code=1 ;;
    superseded) code=2 ;;
    unused) code=3 ;;
    *) report_error "$(argvus_tr launcher error.gpg_bad_reason reason="$reason")" ;;
  esac
  require_yes "$confirmed"
  require_gpg
  ensure_pinentry
  # Answers in order: revoke this key, the reason number, an empty description,
  # then save. The revocation is recorded in the keyring by gpg itself.
  printf 'revkey\ny\n%s\n\ny\nsave\n' "$code" \
    | gpg --no-tty --yes --pinentry-mode ask --command-fd 0 --edit-key "$fingerprint" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  argvus_tr launcher message.gpg_revoked fingerprint="$fingerprint"
}

# Sets how far the key is trusted: none, marginal, full or ultimate. Ultimate
# asks gpg for one more confirmation, which is answered here.
edit_trust() {
  [ "$#" -eq 2 ] || usage
  fingerprint=$1
  level=$2
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  case "$level" in
    none) value=2 ;;
    marginal) value=3 ;;
    full) value=4 ;;
    ultimate) value=5 ;;
    *) report_error "$(argvus_tr launcher error.gpg_bad_trust level="$level")" ;;
  esac
  require_gpg
  if [ "$value" -eq 5 ]; then
    answers=$(printf 'trust\n%s\ny\nquit\n' "$value")
  else
    answers=$(printf 'trust\n%s\nquit\n' "$value")
  fi
  printf '%s\n' "$answers" \
    | gpg --no-tty --yes --command-fd 0 --edit-key "$fingerprint" >/dev/null 2>&1 \
    || report_error "$(argvus_tr launcher error.gpg_action_failed fingerprint="$fingerprint")"
  argvus_tr launcher message.gpg_trust_set fingerprint="$fingerprint" level="$level"
}

edit_key() {
  [ "$#" -ge 1 ] || usage
  action=$1
  shift
  case "$action" in
    expire) edit_expire "$@" ;;
    passwd) edit_passwd "$@" ;;
    sign) edit_sign "$@" ;;
    revoke) edit_revoke "$@" ;;
    trust) edit_trust "$@" ;;
    *) usage ;;
  esac
}

# Sends or fetches a key with the keyserver that gpg is configured to use.
# Sending publishes the key, so it needs --yes.
keyserver() {
  [ "$#" -ge 2 ] || usage
  action=$1
  fingerprint=$2
  shift 2
  confirmed=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) confirmed=1 ;;
      *) usage ;;
    esac
    shift
  done
  valid_fingerprint "$fingerprint" || report_error "$(argvus_tr launcher error.gpg_invalid_fingerprint fingerprint="$fingerprint")"
  require_gpg
  case "$action" in
    send)
      require_yes "$confirmed"
      gpg --no-tty --batch --send-keys "$fingerprint" >/dev/null 2>&1 \
        || report_error "$(argvus_tr launcher error.gpg_keyserver_failed fingerprint="$fingerprint")"
      argvus_tr launcher message.gpg_sent fingerprint="$fingerprint"
      ;;
    recv)
      gpg --no-tty --batch --recv-keys "$fingerprint" >/dev/null 2>&1 \
        || report_error "$(argvus_tr launcher error.gpg_keyserver_failed fingerprint="$fingerprint")"
      argvus_tr launcher message.gpg_received fingerprint="$fingerprint"
      ;;
    *) usage ;;
  esac
}

case "${1:-}" in
  ''|-h|--help|help)
    argvus_tr launcher help.gpg
    exit 0
    ;;
  list)
    list_keys
    exit 0
    ;;
  generate)
    shift
    generate_key "$@"
    exit 0
    ;;
  export-public)
    shift
    export_public "$@"
    exit 0
    ;;
  import)
    shift
    import_key "$@"
    exit 0
    ;;
  status)
    status_pinentry
    exit 0
    ;;
  import-private)
    shift
    import_private "$@"
    exit 0
    ;;
  export-private)
    shift
    export_private "$@"
    exit 0
    ;;
  delete)
    shift
    delete_key "$@"
    exit 0
    ;;
  edit)
    shift
    edit_key "$@"
    exit 0
    ;;
  keyserver)
    shift
    keyserver "$@"
    exit 0
    ;;
  *)
    usage
    ;;
esac
