#!/usr/bin/env sh

set -eu

ARGVUS_CONFIG_HOME=${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}
ARGVUS_SYSTEM_CONFIG=${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}
ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-$ARGVUS_SYSTEM_CONFIG/session/sh/bootstrap.sh}"

if [ -r "$ARGVUS_BOOTSTRAP" ]; then
  # shellcheck disable=SC1090,SC1091
  . "$ARGVUS_BOOTSTRAP"
  ROFI_CONFIG="$(paths_config launcher/config/config.rasi)"
else
  ROFI_CONFIG="$ARGVUS_SYSTEM_CONFIG/launcher/config/config.rasi"
fi

if [ "${1:-}" = "--config" ]; then
  [ "$#" -ge 2 ] || {
    printf 'argvus-launcher: --config requires a value\n' >&2
    exit 1
  }
  ROFI_CONFIG="$2"
  shift 2
fi

case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
  pt_*) PROMPT="Pesquisar aplicação" ;;
  *) PROMPT="Search application" ;;
esac

exec rofi -config "$ROFI_CONFIG" -show drun -display-drun "$PROMPT" "$@"
