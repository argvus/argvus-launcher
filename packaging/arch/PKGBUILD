# Maintainer: William C. Canin
pkgname=argvus-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Rofi launcher configuration, themes and menus for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-launcher"
license=('GPL-3.0-only')
depends=(
  'argvus-session'
  'argvus-appearance'
  'bash'
  'libnotify'
  'rofi'
  'rofi-calc'
  'rofimoji'
  'wl-clipboard'
  'wtype'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}
