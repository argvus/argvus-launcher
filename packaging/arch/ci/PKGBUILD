# Maintainer: William C. Canin
pkgname=argvus-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Rofi launcher configuration, themes and menus for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-launcher"
license=('GPL-3.0-only')
depends=(
  'argvus-session'
  'argvus-appearance'
  'argvus-i18n'
  'bash'
  'libnotify'
  'rofi'
  'rofi-calc'
  'rofimoji'
  'wl-clipboard'
  'wtype'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_launcher_payload
}

package() {
  arch_package_launcher_payload
}
